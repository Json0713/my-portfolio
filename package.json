{
  "name": "my-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:ui\" \"npm run dev:api\"",
    "dev:ui": "vite --port 3000 --strictPort",
    "dev:api": "vercel dev --listen 3001 --yes",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{js,css,html}\" \"*.html\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\" \"*.html\""
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "dompurify": "^3.2.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.5.3",
    "vite": "^6.3.5"
  }
}
